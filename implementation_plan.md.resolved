memory/
├── memory-manager.ts      # CRUD operations on MEMORY/ directories
├── work-tracker.ts        # WORK/ directory management, PRD lifecycle
├── learning-capture.ts    # LEARNING/ categorization and writing
├── signals.ts             # ratings.jsonl management
├── state-manager.ts       # STATE/ runtime data
└── harvester.ts           # Session transcript harvesting
```

