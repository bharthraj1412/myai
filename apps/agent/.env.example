# AG3NT Agent Worker Environment Configuration
# Copy this file to .env and fill in your API keys

# Model Provider Configuration
# Options: anthropic, openai, openrouter, kimi, google
AG3NT_MODEL_PROVIDER=openrouter

# Model Name (provider-specific format)
# Anthropic: claude-sonnet-4-5-20250929, claude-3-opus-20240229
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, meta-llama/llama-3.1-405b-instruct
# Kimi: moonshot-v1-128k, moonshot-v1-32k, moonshot-v1-8k, kimi-latest
# Google: gemini-pro, gemini-pro-1.5
AG3NT_MODEL_NAME=moonshotai/kimi-k2-thinking

# API Keys (set the one for your chosen provider)
# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL (for NVIDIA, local gateways, etc.)
# Example: https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=

# Get OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional OpenRouter-compatible base URL override
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Get Kimi key from: https://platform.moonshot.cn/
KIMI_API_KEY=

# Get Google key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Example presets:
# OpenRouter free model
# AG3NT_MODEL_PROVIDER=openrouter
# AG3NT_MODEL_NAME=openrouter/free
# OPENROUTER_API_KEY=your_openrouter_key
#
# NVIDIA model via OpenAI-compatible endpoint
# AG3NT_MODEL_PROVIDER=openai
# AG3NT_MODEL_NAME=qwen/qwen3-coder-480b-a35b-instruct
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=your_nvidia_api_key

# Optional: LangSmith tracing (for debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ag3nt

